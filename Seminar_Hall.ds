 application "Seminar Hall"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Seminar_Booking
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Hall
			(
				type = picklist
				maxchar = 100
				values = {"Hall 1","Hall 2","Auditorium"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Booking_date
			(
    			type = date
				displayname = "Booking date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Start_Hour
			(
				type = number
				displayname = "Start Hour"
				maxchar = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have End_Hour
			(
				type = number
				displayname = "End Hour"
				maxchar = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Event_Name
			(
    			type = text
				displayname = "Event Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Orani
			(
    			type = text
				displayname = "Organizer Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Seminar_Booking_Report
		{
			displayName = "Seminar_Booking Report"
			show all rows from Seminar_Booking    
			(
				Hall
				Booking_date as "Booking date"
				Start_Hour as "Start Hour"
				End_Hour as "End Hour"
				Event_Name as "Event Name"
				Orani as "Organizer Name"
			)
			conditional formatting
			(
				"New Formatting"
				{
				fields = [Hall]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
	}




	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}

	customize
	{
		icon
		{
			text = "SH"
			background color = "theme"
			foreground color = "#ffffff"
		}
	}

	web
	{
		forms
		{
			form Seminar_Booking
			{
				label placement = left
			}
		}
		reports
		{
			report Seminar_Booking_Report
			{
				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Hall
								Booking_date as "Booking date"
								Start_Hour as "Start Hour"
								End_Hour as "End Hour"
								Event_Name as "Event Name"
								Orani as "Organizer Name"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Hall
								Booking_date as "Booking date"
								Start_Hour as "Start Hour"
								End_Hour as "End Hour"
								Event_Name as "Event Name"
								Orani as "Organizer Name"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			}
		}
		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Seminar_Booking
				{
					displayname = "Seminar_Booking"
					icon = "tech-desktop"
					form  Seminar_Booking
					{
						icon = "tech-desktop"
					}
					report Seminar_Booking_Report
					{
						icon = "tech-desktop"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
			}
			preference
			{
				icon
				{
					style = outline
				}
			}
		}
		customize
		{
			font = "lato"
			color options
			{
				color = "11"
			}
			logo
			{
				preference = "app_icon"
				placement = "left"
			}
		}
	}
	phone
	{
		customize
		{
			layout = twocolumn
			font = "default"
			style = "3"
			color options
			{
				color = chryslerpurple
			}
			logo
			{
				preference = "none"
			}
		}
	}
	tablet
	{
		customize
		{
			layout = slidingpane
			font = "default"
			style = "3"
			color options
			{
				color = red
			}
			logo
			{
				preference = "none"
			}
		}
	}
	translation
{
{"Language_Settings":{"LANGAGUE_WITH_LOGIN":"browser"}}
}
}
