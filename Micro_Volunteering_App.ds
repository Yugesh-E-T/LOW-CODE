 * Version      : 1.0
 */
 application "Micro Volunteering App"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form task_assignment
		{
			displayname = "Task Assignment"
			success message = "Task Assignment Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			task
			(
				type = list	
				displayname = "Task"
				values  = task_management.ID
    			displayformat = [task_title]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			volunteer
			(
				type = list	
				displayname = "Volunteer"
				values  = volunteer_profile.ID
    			displayformat = [volunteer_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			assignment_date
			(
    			type = datetime
				displayname = "Assignment Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			slot_number
			(
				type = number
				displayname = "Slot Number"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			assignment_status
			(
				type = picklist
				displayname = "Assignment Status"
				values = {"Assigned","Completed","Confirmed","Cancelled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			completion_date
			(
    			type = datetime
				displayname = "Completion Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			feedback
			(
    			type = textarea
				displayname = "Feedback"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Assignment Draft","Pending Volunteer Selection","Assignment Cancelled","Volunteers Assigned","Task In Progress","Task Completed","Task On Hold","Pending Feedback","Assignment Closed"}
			}
		}
		form task_management
		{
			displayname = "Task Management"
			success message = "Task Management Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			task_title
			(
    			type = text
				displayname = "Task Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			category
			(
				type = picklist
				displayname = "Category"
				values = {"Education","Technology","Healthcare","Environment","Community","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			required_skills
			(
				type = list	
				displayname = "Required Skills"
				values = {"Event Planning","Design","Translation","Gardening","Programming","First Aid","Teaching","Logistics"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			task_type
			(
				type = picklist
				displayname = "Task Type"
				values = {"One-time","Recurring","Event","Project-based"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			location
			(
    			type = address
				displayname = "Location"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_duration
			(
				type = number
				displayname = "Estimated Duration"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			volunteer_slots
			(
				type = number
				displayname = "Volunteer Slots"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			deadline
			(
    			type = datetime
				displayname = "Deadline"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			task_status
			(
				type = picklist
				displayname = "Task Status"
				values = {"Completed","In Progress","Canceled","Open"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_by
			(
    			type = text
				displayname = "Created By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form volunteer_profile
		{
			displayname = "Volunteer Profile"
			success message = "Volunteer Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have volunteer_name
			(
    			type = name
				displayname = "Volunteer Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have skills
			(
				type = list	
				displayname = "Skills"
				values = {"Event Planning","Design","Translation","Gardening","Programming","First Aid","Teaching","Logistics"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have availability_status
			(
				type = picklist
				displayname = "Availability Status"
				values = {"On Leave","Busy","Available"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			max_slots
			(
				type = number
				displayname = "Max Slots"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have joined_date
			(
    			type = date
				displayname = "Joined Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			bio
			(
    			type = textarea
				displayname = "Bio"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_location
			(
    			type = text
				displayname = "Preferred Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Registration Initiated","Profile Pending Verification","Registration Rejected","Skills Verification Required","Profile Approved","Skills Verified","Skills Verification Failed","Onboarding Complete"}
			}
		}
	}
	reports
	{
		list task_assignment_Report
		{
			displayName = "All Task Assignments"
			show all rows from task_assignment    
			(
				task as "Task"
				volunteer as "Volunteer"
				assignment_date as "Assignment Date"
				slot_number as "Slot Number"
				assignment_status as "Assignment Status"
				notes as "Notes"
				completion_date as "Completion Date"
				feedback as "Feedback"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (assignment_status == "Assigned")
				fields = [assignment_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (assignment_status == "Completed")
				fields = [assignment_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban task_assignment_by_assignment_status
		{
			displayName = "Assignment Statuses"
			show all rows from task_assignment    
			(
				task as "Task"
				volunteer as "Volunteer"
				assignment_date as "Assignment Date"
				slot_number as "Slot Number"
				assignment_status as "Assignment Status"
				notes as "Notes"
				completion_date as "Completion Date"
				feedback as "Feedback"
			)
			options
			(
	 			display field = assignment_status
	 		)
		}
		list volunteer_profile_Report
		{
			displayName = "All Volunteer Profiles"
			show all rows from volunteer_profile    
			(
				volunteer_name  as "Volunteer Name"
				email as "Email"
				phone_number as "Phone Number"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				skills as "Skills"
				availability_status as "Availability Status"
				max_slots as "Max Slots"
				joined_date as "Joined Date"
				bio as "Bio"
				preferred_location as "Preferred Location"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (availability_status == "Available")
				fields = [availability_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (availability_status == "Busy")
				fields = [availability_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (availability_status == "On Leave")
				fields = [availability_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban volunteer_profile_by_availability_status
		{
			displayName = "Availability Statuses"
			show all rows from volunteer_profile    
			(
				volunteer_name  as "Volunteer Name"
				email as "Email"
				phone_number as "Phone Number"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				skills as "Skills"
				availability_status as "Availability Status"
				max_slots as "Max Slots"
				joined_date as "Joined Date"
				bio as "Bio"
				preferred_location as "Preferred Location"
			)
			options
			(
	 			display field = availability_status
	 		)
		}
		list task_management_Report
		{
			displayName = "All Task Management"
			show all rows from task_management    
			(
				task_title as "Task Title"
				description as "Description"
				category as "Category"
				required_skills as "Required Skills"
				task_type as "Task Type"
				location  as "Location"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				estimated_duration as "Estimated Duration"
				volunteer_slots as "Volunteer Slots"
				deadline as "Deadline"
				task_status as "Task Status"
				created_by as "Created By"
				created_date as "Created Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (task_type == "Event")
				fields = [task_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (task_type == "One-time")
				fields = [task_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban task_management_by_category
		{
			displayName = "Categories"
			show all rows from task_management    
			(
				task_title as "Task Title"
				description as "Description"
				category as "Category"
				required_skills as "Required Skills"
				task_type as "Task Type"
				location  as "Location"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				estimated_duration as "Estimated Duration"
				volunteer_slots as "Volunteer Slots"
				deadline as "Deadline"
				task_status as "Task Status"
				created_by as "Created By"
				created_date as "Created Date"
			)
			options
			(
	 			display field = category
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
