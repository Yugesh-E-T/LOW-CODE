		}
	}
	chats
	{
		chat AI_Volunteer_Assistant
		{
			display name = "VolunBot"
			access level = read_write
			instructions
			(
				value = "You are the AI Volunteer Assistant for the Micro Volunteer Task Manager application. Your primary role is to assist volunteers by helping them find available tasks, explaining requirements, and checking their application status. \n\nYou must use the Task_Management and Volunteer_Profile modules to retrieve and interact with data. \n\nYour responses should be friendly, clear, and concise. \n\nStrictly adhere to the following security and privacy rules:\n1. Only allow volunteers to access their own permitted information.\n2. Do not approve tasks or modify records unless explicitly authorized by a system admin (which you are not).\n3. Never expose private information belonging to other volunteers.\n4. If a user asks for unauthorized actions or data, politely decline and explain the restriction.\n5. Focus on read operations and guiding users on how to proceed within the application's standard workflows."
			)
			personalization
			(
				welcome message = "Hello! I'm your AI Volunteer Assistant. I can help you find tasks, check your status, and answer questions about volunteering. How can I assist you today?"
			)
			forms
			(
				volunteer_profile
				task_management
			)
		}
	}




		workflow
		{
		form
		{
			auto_assign_volunteer_slots as "Auto-Assign Volunteer Slots"
			{
				type =  form
				form = task_assignment

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the last task assignment record to determine the next slot number
										lastAssignment = task_assignment[assignment_status == "Assigned" || assignment_status == "Confirmed"] sort by slot_number range from 0 to 1;
										// Initialize next slot number to 1 if no assignments exist
										nextSlotNumber = 1;
										if(lastAssignment.count() > 0)
										{
											// Get the highest slot number from existing assignments
											highestSlot = lastAssignment.slot_number;
											// Set next slot number as highest + 1
											nextSlotNumber = highestSlot + 1;
										}
										// Set the slot number field in the form
										input.slot_number = nextSlotNumber;
						)
					}
				}

			}
			validate_skill_match as "Validate Skill Match"
			{
				type =  form
				form = task_assignment

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the task record using the lookup field from input
										if(input.task.isNull())
										{
											alert "Task is not selected. Please select a valid task.";
											cancel submit;
										}
										taskRecord = task_management[ID == input.task];
										// Fetch the volunteer records using the multi-select lookup field
										if(input.volunteer.isEmpty())
										{
											alert "No volunteers selected. Please select at least one volunteer.";
											cancel submit;
										}
										volunteerRecords = volunteer_profile[ID in input.volunteer];
										// Get the required skills from the task
										requiredSkills = taskRecord.required_skills;
										// Flag to track if any volunteer has matching skills
										hasMatchingVolunteer = false;
										// Iterate through each selected volunteer to check skill match
										for each  volunteer in volunteerRecords
										{
											volunteerSkills = input.volunteer.skills;
											// Check if volunteer has at least one of the required skills
											for each  requiredSkill in requiredSkills
											{
												if(volunteerSkills.contains(requiredSkill))
												{
													hasMatchingVolunteer = true;
													break;
												}
											}
											// If we found a matching volunteer, we can stop checking
											if(hasMatchingVolunteer)
											{
												break;
											}
										}
										// If no volunteer has matching skills, cancel submission
										if(!hasMatchingVolunteer)
										{
											alert "None of the selected volunteers have the required skills for this task. Please select volunteers with matching skills.";
											cancel submit;
										}
						)
					}
				}

			}
			notify_on_task_completion as "Notify on Task Completion"
			{
				type =  form
				form = task_assignment

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the task record using the lookup field from task_assignment form
										taskRecord = task_management[ID == input.task];
										// Check if task status is Completed
										if(taskRecord.task_status == "Completed")
										{
											// Get volunteer details from multi-select lookup
											for each  volunteer in input.volunteer
											{
												// Fetch volunteer profile record
												volunteerRecord = volunteer_profile[ID == input.volunteer];
												// Get volunteer email
												Email = volunteerRecord.email;
												// Get task title
												taskTitle = taskRecord.task_title;
												// Send email notification to volunteer
												sendmail
												[
													from :zoho.loginuserid
													to :Email
													subject :"Task Completed: " + taskTitle
													message :"Dear " + volunteerRecord.volunteer_name.first_name + ",\n\nYour assigned task '" + taskTitle + "' has been completed.\n\nThank you for your contribution!\n\nBest regards,\nMicro Volunteer Task Manager"
												]
											}
										}
						)
					}
				}

			}
			send_welcome_email_on_volunteer_registration as "Send Welcome Email on Volunteer Registration"
			{
				type =  form
				form = volunteer_profile

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the volunteer's email from the current input
										volunteerEmail = input.email;
										// Check if email is available before sending
										if(!volunteerEmail.isNull())
										{
											// Send email notification to the volunteer
											sendmail
											[
												from :zoho.adminuserid
												to :volunteerEmail
												subject :"Welcome to the Volunteer Network"
												message :"<p>Dear Volunteer,</p><p>Your profile has been successfully created. We are excited to have you on board!</p><p>Best regards,<br>Task Management Team</p>"
											]
										}
										else
										{
											// Log if email is missing
											info "Email address is missing for the new volunteer profile.";
										}
						)
					}
				}

			}
			notify_volunteers_on_task_completion as "Notify Volunteers on Task Completion"
			{
				type =  form
				form = task_assignment

				record event = on edit

				on update of assignment_status
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the task assignment record being updated
										assignmentRecord = task_assignment[ID == input.ID];
										// Check if assignment status is updated to Completed
										if(input.assignment_status == "Completed")
										{
											// Fetch the related task record to check its status
											taskID = assignmentRecord.task.ID;
											taskRecord = task_management[ID == taskID];
											// Check if the task is also marked as Completed
											if(taskRecord.task_status == "Completed")
											{
												// Fetch all volunteers assigned to this assignment
												volunteerList = assignmentRecord.volunteer;
												// Iterate through each volunteer and send email
												for each  volunteer in volunteerList
												{
													Email = input.volunteer.email;
													volunteerName = input.volunteer.volunteer_name.first_name;
													taskTitle = taskRecord.task_title;
													if(!isNull(Email))
													{
														sendmail
														[
															from :zoho.adminuserid
															to :Email
															subject :"Task Assignment Completed: " + taskTitle
															message :"<p>Dear " + volunteerName + ",</p><p>Your task assignment for '" + taskTitle + "' has been marked as Completed.</p><p>Thank you for your contribution!</p>"
														]
													}
												}
											}
										}
						)
					}
				}

			}
		}




